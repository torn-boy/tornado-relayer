NET_ID=1
# Public Ethereum mainnet RPCs. The tree watcher needs historical logs and WebSocket subscriptions.
HTTP_RPC_URL=https://ethereum-rpc.publicnode.com
WS_RPC_URL=wss://ethereum-rpc.publicnode.com
ORACLE_RPC_URL=https://ethereum-rpc.publicnode.com
REDIS_URL=redis://127.0.0.1:6379

# DNS settings
VIRTUAL_HOST=example.duckdns.org
LETSENCRYPT_HOST=example.duckdns.org
APP_PORT=8000

# without 0x prefix
PRIVATE_KEY=
# 0.4 means 0.4%
REGULAR_TORNADO_WITHDRAW_FEE=0.4
MINING_SERVICE_FEE=0.05
REWARD_ACCOUNT=
CONFIRMATIONS=4

# in GWEI
MAX_GAS_PRICE=1000
BASE_FEE_RESERVE_PERCENTAGE=25
AGGREGATOR=0x8cb1436F64a3c33aD17bb42F94e255c4c0E871b2
