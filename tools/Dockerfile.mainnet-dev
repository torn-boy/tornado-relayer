FROM node:16.20.2-bullseye-slim@sha256:503446c15c6236291222f8192513c2eb56a02a8949cbadf4fe78cce19815c734 AS dependencies
WORKDIR /app
COPY archives/ archives/
COPY package.json yarn.lock typescript.tgz ./
RUN yarn install --offline --frozen-lockfile --ignore-scripts --non-interactive
# The historical oracle is distributed as TypeScript source in this build.
RUN mkdir /tmp/compiler && tar xzf typescript.tgz -C /tmp/compiler \
    && cd node_modules/@tornado/tornado-oracles \
    && node /tmp/compiler/package/bin/tsc -p tsconfig.json \
    && node /tmp/compiler/package/bin/tsc -p tsconfig.esm.json

FROM node:16.20.2-bullseye-slim@sha256:503446c15c6236291222f8192513c2eb56a02a8949cbadf4fe78cce19815c734
LABEL org.opencontainers.image.revision="4641d9a3af63aac49c45ec2c39117ac0b483ce1f"
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json yarn.lock ./
COPY abis/ abis/
COPY cache/ cache/
COPY keys/ keys/
COPY src/ src/
COPY test/ test/
RUN yarn test
EXPOSE 8000
ENTRYPOINT ["yarn"]
