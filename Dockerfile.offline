# Build from the context generated by scripts/prepare-offline-build.py.
ARG NODE_IMAGE=node:16.20.2-bullseye-slim@sha256:503446c15c6236291222f8192513c2eb56a02a8949cbadf4fe78cce19815c734
FROM ${NODE_IMAGE} AS dependencies
WORKDIR /app
COPY package.json yarn.lock ./
COPY public/ /app/build-deps/public/
COPY vendor/ /app/build-deps/vendor/
RUN yarn install --frozen-lockfile --offline --ignore-scripts --non-interactive

FROM ${NODE_IMAGE}
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules/
COPY package.json yarn.lock build-provenance.json ./
COPY src/ ./src/
COPY abis/ ./abis/
COPY cache/ ./cache/
COPY keys/ ./keys/
COPY test/ ./test/
EXPOSE 8000
ENTRYPOINT ["yarn"]
